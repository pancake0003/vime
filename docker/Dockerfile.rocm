# vime on AMD ROCm, layered on the vLLM ROCm nightly base image.
#
# Inherited from base (vllm/vllm-openai-rocm:nightly, ROCm 7.2.3):
#   Python 3.12, PyTorch 2.12 (ROCm), vLLM (incl. weight-transfer IPC engine),
#   aiter, triton, flash-attn 2.8.3, numpy 2.3.5 / scipy 1.18.1.
# Added here (the training bits the base lacks):
#   TransformerEngine (ROCm), apex (ROCm), Megatron-LM (ROCm fork),
#   torch_memory_saver, flash-linear-attention, ray, vime.
#
# Dependency stack validated by importing every component against the base's
# torch 2.12 before this file was written.
#
# NIXL rollout transport (--rollout-data-transport nixl) is OPT-IN and needs the
# `nixl` package + a ROCm-enabled backend; the default object-store transport
# needs nothing extra. It is not installed here.
#
# Build:
#   DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile.rocm \
#     --build-arg GPU_ARCH=gfx950 -t vime-rocm-nightly .

ARG BASE_IMAGE=vllm/vllm-openai-rocm:nightly
FROM ${BASE_IMAGE}

ARG GPU_ARCH=gfx950
ENV PYTORCH_ROCM_ARCH=${GPU_ARCH}

WORKDIR /root

# ====================================== apex (ROCm) ===========================
# Training-only prebuilt wheel matching the base ROCm (7.2.3). vime runs with
# --no-gradient-accumulation-fusion, so a miss here is non-fatal.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-deps \
      https://repo.radeon.com/rocm/manylinux/rocm-rel-7.2.3/apex-1.9.0+rocm7.2.3.git355db9b8-cp312-cp312-linux_x86_64.whl || \
    echo "WARN: apex install skipped/failed (training-only; vime uses --no-gradient-accumulation-fusion)"

# ================================ TransformerEngine (ROCm) ====================
# AMD's prebuilt TE 2.6.0 for rocm-rel-7.2.3. The ROCm/TransformerEngine source
# build targets an older PyTorch C++ ABI (c10::hip::HIPGuardMasqueradingAsCUDA)
# and does not compile against the base's torch 2.12; the prebuilt wheels link
# cleanly against it. Base flash-attn is exactly 2.8.3, within TE's range, so no
# version-cap patch is needed.
ENV NVTE_USE_ROCM=1
ENV NVTE_FRAMEWORK=pytorch
ARG TE_REL=rocm-rel-7.2.3
ARG TE_VERSION=2.6.0
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-build-isolation \
      "https://repo.radeon.com/rocm/manylinux/${TE_REL}/transformer_engine_torch-${TE_VERSION}.tar.gz" && \
    pip install --no-deps \
      "https://repo.radeon.com/rocm/manylinux/${TE_REL}/transformer_engine-${TE_VERSION}-py3-none-any.whl" \
      "https://repo.radeon.com/rocm/manylinux/${TE_REL}/transformer_engine_rocm-${TE_VERSION}-py3-none-manylinux_2_28_x86_64.whl"

# ====================================== Megatron-LM ===========================
# ROCm's Megatron-LM fork already carries the AMD changes previously applied via
# docker/amd_patch/*.patch on top of NVIDIA's tree. The ROCm fork-after-HIP-init
# checkpoint segfault is handled at runtime by vime.utils.rocm_checkpoint_writer.
ARG MEGATRON_REPO=https://github.com/ROCm/Megatron-LM.git
ARG MEGATRON_COMMIT=fb4552449f9b33c6f72207a80e80045eadf5267e
RUN --mount=type=cache,target=/root/.cache/pip \
    git clone ${MEGATRON_REPO} --recursive /root/Megatron-LM && \
    cd /root/Megatron-LM && git checkout ${MEGATRON_COMMIT} && \
    pip install -e .

# ==================================== training deps ===========================
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --ignore-installed PyJWT && \
    pip install flash-linear-attention==0.4.2 && \
    pip install git+https://github.com/ISEEKYAN/mbridge.git@89eb10887887bc74853f89a4de258c0702932a1c --no-deps && \
    pip install git+https://github.com/radixark/Megatron-Bridge.git@bridge --no-deps --no-build-isolation && \
    pip install megatron-energon --no-deps && \
    pip install multi-storage-client --no-deps

# torch_memory_saver: the fzyzcjy fork (the zhuzilin variant can crash on ROCm).
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install git+https://github.com/fzyzcjy/torch_memory_saver.git@d64a639 \
        --no-cache-dir --force-reinstall

# ======================================== vime ================================
# Megatron-LM hard-asserts numpy 1.x at runtime (tools/convert_hf_to_torch_dist.py:
# "Megatron does not support numpy 2.x"), so pin numpy 1.26.4 + a numpy-1.x-
# compatible scipy, matching the NVIDIA image. Base vLLM/torch still import fine
# against numpy 1.26.4 (verified — no ABI break).
COPY requirements.txt /tmp/vime-requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /tmp/vime-requirements.txt && \
    pip install "numpy==1.26.4" "scipy==1.17.1"

COPY . /root/vime
RUN --mount=type=cache,target=/root/.cache/pip \
    cd /root/vime && pip install -e . --no-deps

ENV CUDA_DEVICE_MAX_CONNECTIONS=1
ENV HSA_NO_SCRATCH_RECLAIM=1
ENV VLLM_ROCM_USE_AITER=1
ENV PYTHONPATH=/root/vime:/root/Megatron-LM
# vime's rollout POSTs to vLLM's /inference/v1/generate (the scale_out
# token-in-token-out router), which vLLM only mounts when this is set. The base
# defaults it to None; without it the route 404s and rollout can't reach the engine.
ENV VLLM_ENABLE_SCALE_OUT_ENDPOINTS=1

# Reset the base ENTRYPOINT (`vllm serve`) so `docker run ... bash -c ...` and
# `ray job submit` work as a plain bash/ray environment.
ENTRYPOINT []
CMD ["/bin/bash"]

RUN python3 -c "\
import vllm, vime; \
from vime.backends.vllm_utils.vllm_engine import VLLMEngine; \
print('vllm', vllm.__version__); \
print('VLLMEngine import ok')"

WORKDIR /root/vime
